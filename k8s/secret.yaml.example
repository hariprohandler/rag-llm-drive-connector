apiVersion: v1
kind: Secret
metadata:
  name: rag-app-secrets
  namespace: rag-system
  labels:
    app: rag-llm-drive-connector
type: Opaque
stringData:
  # Database
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "your-secure-password-here"
  DATABASE_URL: "postgresql+psycopg2://postgres:your-secure-password-here@postgres-service:5432/postgres"
  
  # OpenAI
  OPENAI_API_KEY: "your-openai-api-key"
  
  # Google OAuth (Base64 encoded or plain text)
  GOOGLE_CLIENT_ID: "your-google-client-id"
  GOOGLE_CLIENT_SECRET: "your-google-client-secret"
  GOOGLE_REDIRECT_URI: "https://your-domain.com/auth/google/callback"
  
  # Microsoft OAuth
  MICROSOFT_CLIENT_ID: "your-microsoft-client-id"
  MICROSOFT_CLIENT_SECRET: "your-microsoft-client-secret"
  MICROSOFT_TENANT_ID: "your-tenant-id"
  MICROSOFT_REDIRECT_URI: "https://your-domain.com/auth/onedrive/callback"

---
# Instructions:
# 1. Copy this file to secret.yaml (DO NOT commit secret.yaml to git)
# 2. Update the values with your actual secrets
# 3. Apply: kubectl apply -f k8s/secret.yaml
# 
# Alternatively, use sealed-secrets or external-secrets operator:
# kubectl create secret generic rag-app-secrets \
#   --from-literal=OPENAI_API_KEY=your-key \
#   --from-literal=POSTGRES_PASSWORD=your-password \
#   -n rag-system

